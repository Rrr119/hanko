create_table("passkey_devices") {
	t.Column("id", "uuid", {primary: true})
	t.Column("tenant_id", "uuid", {"null": false})
	t.Column("user_id", "uuid", {"null": false})
	t.Column("parent_id", "string", {"size": 36, "null": false, "default": ""})
	t.Column("root_id", "string", {"size": 36, "null": false})
	t.Column("replaces_id", "string", {"size": 36, "null": false, "default": ""})
	t.Column("relation", "string", {"size": 64, "null": false})
	t.Column("status", "string", {"size": 32, "null": false})
	t.Column("platform", "string", {"size": 32, "null": false, "default": ""})
	t.Column("sync_fabric", "string", {"size": 128, "null": false, "default": ""})
	t.Column("label", "string", {"size": 255, "null": false, "default": ""})
	t.Column("trusted_at", "timestamp", {"null": false})
	t.Column("last_seen_at", "timestamp", {"null": false})
	t.Column("expires_at", "timestamp", {"null": true})
	t.Column("lost_at", "timestamp", {"null": true})
	t.Column("revoked_at", "timestamp", {"null": true})
	t.Timestamps()
	t.Index(["tenant_id", "user_id"])
	t.Index(["tenant_id", "id"], {"unique": true})
}

create_table("passkey_device_credentials") {
	t.Column("id", "uuid", {primary: true})
	t.Column("tenant_id", "uuid", {"null": false})
	t.Column("user_id", "uuid", {"null": false})
	t.Column("device_id", "uuid", {"null": false})
	t.Column("credential_id", "text", {"null": false})
	t.Column("credential_id_hash", "string", {"size": 64, "null": false})
	t.Timestamps()
	t.Index(["tenant_id", "user_id", "credential_id_hash"], {"name": "passkey_device_creds_lookup_idx"})
	t.Index(["device_id"])
}

create_table("passkey_migration_grants") {
	t.Column("id", "uuid", {primary: true})
	t.Column("tenant_id", "uuid", {"null": false})
	t.Column("user_id", "uuid", {"null": false})
	t.Column("source_device_id", "uuid", {"null": false})
	t.Column("token_hash", "string", {"size": 64, "null": false})
	t.Column("target_platform", "string", {"size": 32, "null": false, "default": ""})
	t.Column("target_sync_fabric", "string", {"size": 128, "null": false, "default": ""})
	t.Column("expires_at", "timestamp", {"null": false})
	t.Column("consumed_at", "timestamp", {"null": true})
	t.Column("consumed_device_id", "uuid", {"null": true})
	t.Column("revoked_at", "timestamp", {"null": true})
	t.Timestamps()
	t.Index("token_hash", {"unique": true})
	t.Index(["tenant_id", "user_id", "source_device_id"], {"name": "passkey_migration_source_idx"})
}
